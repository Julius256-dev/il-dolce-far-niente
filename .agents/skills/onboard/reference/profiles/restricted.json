{
  "description": "Classified or regulated code: confirm in writing whether source may leave the premises before any agent runs; parallel builds off, web research off, every gate on, a named human approves each landing.",
  "config": {
    "profile": "restricted",
    "git": {
      "landing": "pull-request"
    },
    "workflow": {
      "stepReview": "every",
      "checkpointCommits": "enabled"
    },
    "qualityGates": {
      "regular": {
        "audit": "always",
        "independentReview": "always",
        "check": "always",
        "tryGuide": "when-testable"
      },
      "continuous": {
        "audit": "always",
        "independentReview": "always",
        "check": "always",
        "tryGuide": "when-testable"
      }
    },
    "avengers": {
      "maxConcurrent": 1,
      "specApproval": "each",
      "finalIntegrationAudit": true,
      "serializeWhen": [
        "sensitive",
        "shared-files",
        "migration",
        "auth",
        "payments",
        "sms",
        "config"
      ]
    },
    "research": {
      "web": false
    },
    "dataHandling": {
      "sourceMayLeavePremises": null,
      "approvalRecord": null
    },
    "models": {
      "main": "inherit",
      "subagentDefault": "inherit",
      "roles": {
        "planner": "inherit",
        "implementer": "inherit",
        "merger": "inherit",
        "reviewer-lens": "inherit",
        "reviewer-standards": "inherit",
        "reviewer-spec": "inherit",
        "explorer": "inherit"
      },
      "effort": {},
      "reviewerMustDiffer": false
    }
  },
  "notes": "Record the client's written answer in dataHandling before any agent session. If source may not leave the premises, run against a locally hosted model through an Anthropic-compatible gateway and keep models on inherit or family aliases. See reference/restricted.md."
}
