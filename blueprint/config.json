{
  "schemaVersion": 1,
  "workflow": {
    "stepReview": "feature",
    "checkpointCommits": "disabled"
  },
  "git": {
    "landing": "local-merge",
    "featureBranchPrefix": "feature/",
    "fixBranchPrefix": "fix/",
    "rollbackBranchPrefix": "rollback/"
  },
  "verification": {
    "logicTests": "when-configured",
    "uiEvidence": "when-available"
  },
  "review": {
    "independentExecution": "automatic"
  },
  "qualityGates": {
    "regular": {
      "audit": "manual",
      "independentReview": "when-sensitive",
      "check": "manual",
      "tryGuide": "when-testable"
    },
    "continuous": {
      "audit": "manual",
      "independentReview": "when-sensitive",
      "check": "manual",
      "tryGuide": "when-testable"
    }
  },
  "continuous": {
    "maxFeatures": null,
    "maxRepairAttempts": 2,
    "finalIntegrationAudit": false
  },
  "profile": "custom",
  "tracker": {
    "kind": "local",
    "doc": "blueprint/context/tracker.md",
    "labels": {
      "bug": "bug",
      "enhancement": "enhancement",
      "needs-triage": "needs-triage",
      "needs-info": "needs-info",
      "ready-for-agent": "ready-for-agent",
      "ready-for-human": "ready-for-human",
      "wontfix": "wontfix"
    }
  },
  "domainDocs": {
    "glossary": "GLOSSARY.md",
    "adr": "docs/adr"
  },
  "avengers": {
    "maxConcurrent": 3,
    "specApproval": "batch",
    "integrationBranchPrefix": "wave/",
    "worktreeRoot": "../.worktrees",
    "serializeWhen": [
      "shared-files",
      "migration",
      "auth",
      "payments",
      "config"
    ],
    "finalIntegrationAudit": true,
    "portBase": 4100
  },
  "models": {
    "main": "claude-opus-5-5",
    "subagentDefault": "claude-sonnet-5-5",
    "roles": {
      "planner": "claude-opus-5-5",
      "reviewer-lens": "claude-opus-5-5",
      "reviewer-standards": "claude-opus-5-5",
      "reviewer-spec": "claude-opus-5-5",
      "implementer": "claude-sonnet-5-5",
      "merger": "claude-sonnet-5-5",
      "explorer": "claude-sonnet-5-5"
    },
    "effort": {
      "planner": "medium",
      "reviewer-lens": "medium",
      "reviewer-standards": "medium",
      "reviewer-spec": "medium"
    },
    "reviewerMustDiffer": true
  }
}
